# Copy this file to .env (or .env.local) and fill in the values. Never commit the real file (it is git-ignored).
# NEXT_PUBLIC_ values are baked into the site when it is BUILT, so on a host (e.g. Hostinger) add them to the
# host's environment variables before building, not just here.

# Supabase (database for the website forms) — Supabase dashboard > Project Settings > API Keys
# The publishable key is designed to be public; Row Level Security in the database is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets for later (admin page, emails, payments). Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications (Hostinger mailbox). Server-only: never prefix with NEXT_PUBLIC_. Read when the server runs.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Spam protection: Cloudflare Turnstile (free). Create a widget at dash.cloudflare.com > Turnstile for finderskeeperssafaris.com.
# The site key is public and baked in at build time; the secret key is server-only. Leave both empty to run without it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Payments (e.g. Stripe / Pesapal / M-Pesa) — add when booking payments are built
PAYMENTS_SECRET_KEY=

# WhatsApp Business Cloud API (optional, for automatic WhatsApp replies)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
