# Copy this file to .env.local and fill in the values. Never commit .env.local (it is git-ignored).
# These stay empty until each service is connected.

# Supabase (database + admin login) — from Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (e.g. Resend or your Hostinger SMTP) — sends enquiry notifications and confirmations
EMAIL_FROM=
EMAIL_API_KEY=

# Payments (e.g. Stripe / Pesapal / M-Pesa) — add when booking payments are built
PAYMENTS_SECRET_KEY=

# WhatsApp Business Cloud API (optional, for automatic WhatsApp replies)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
